# Copy to .env.local and fill in when YOU choose to enable each integration.
# Nothing here is required for the site to build/run at launch.
# --- Payments (Stripe) --- enable lib/payments.ts when set
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# --- Engine Room / analytics --- route lib/tracking.ts here when set
ENGINE_ROOM_ENDPOINT=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
# --- Form submissions (Splose or other CRM) --- wire in the contact Server Action when set
SPLOSE_API_KEY=
